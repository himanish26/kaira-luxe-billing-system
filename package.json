{
  "name": "kaira-luxe-billing",
  "productName": "KAIRA LUXE BILLING SYSTEM",
  "version": "1.0.0",
  "description": "Professional Billing & Inventory Management System for Kaira Luxe",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "manifest": "node updates/generateUpdateManifest.js",
    "release": "npm run dist && npm run manifest"
  },
  "author": "Himanish Patnaik",
  "license": "Single Device Commercial",
   "build": {
    "appId": "com.kairaluxe.billing",
    "productName": "KAIRA LUXE BILLING SYSTEM",
    "artifactName": "KairaLuxeBillingSetup-${version}.${ext}",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/Assets/icons/icon.ico"
    },
    "nsis": {
      "installerIcon": "src/renderer/Assets/icons/installer.ico"
    }
  },
  "type": "commonjs",
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "adm-zip": "^0.6.0",
    "archiver": "^5.3.2",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "exceljs": "^4.4.0",
    "googleapis": "^174.0.0",
    "jsbarcode": "^3.12.3",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  }
}
